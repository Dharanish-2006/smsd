# Copy to .env.production.local (or set these in your CI / hosting dashboard).
# Every VITE_* value is baked into the JavaScript at build time and is PUBLIC.
# Never put secrets here.

# Where the backend API lives. A path like /api means "same site" (put a reverse
# proxy in front); a full URL like https://api.example.com/api works too, but the
# backend must then allow CORS from this site and the CSP connect-src must allow it.
VITE_API_URL=/api

# true = use the built-in demo data (fake machines, accounts stored in the browser).
# Must be false (or unset) in production.
VITE_USE_MOCK=false

# How often to refresh live readings, in milliseconds.
VITE_POLL_INTERVAL_MS=5000

# Give up on a request after this many milliseconds.
VITE_API_TIMEOUT_MS=15000

# true = send cookies with API requests (use when the backend sets an httpOnly
# session cookie instead of returning a bearer token).
VITE_API_CREDENTIALS=false

# Shown on the sign-in screen.
VITE_COMPANY_NAME=Your Company Name
VITE_COMPANY_ADDRESS=Company address, city
VITE_COMPANY_PHONE=+91 00000 00000
VITE_COMPANY_EMAIL=info@example.com

# Sub-path the site is served from (keep / for a domain root).
VITE_BASE_PATH=/

# Dev server only: forward /api to a local backend, e.g. http://localhost:8000
VITE_DEV_API_PROXY=
